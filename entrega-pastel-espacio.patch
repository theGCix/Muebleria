+
+/* ================================================================
+   G&M Mueblería — Variables de diseño para la página de producto
+   Agregar al FINAL de src/styles.css (o en tu index.css, dentro de :root)
+   ================================================================ */
+
+:root {
+  /* Paleta cálida */
+  --color-warm-white:   #FDFAF6;
+  --color-cream:        #F7F4EF;
+  --color-walnut:       #3B2B1F;
+  --color-walnut-mid:   #6B4C38;
+  --color-gold:         #C9A96E;
+  --color-gold-light:   #E8D5B0;
+  --color-blush:        #E8D5CC;
+
+  /* LEGADO (portada/home): estos hex siguen vivos solo para Hero, HeroSlider, PiezaDestacada y
+     MedidaCTA hasta la entrega 2. La ficha y el resto ya usan los tokens de arriba. */
+}
+
+/* Clase utilitaria para títulos display */
+.font-display {
+  font-family: var(--font-display);
+}
+
+/* Altura de botón extra (h-13) — si no la tienes en tu config de Tailwind */
+.h-13 { height: 3.25rem; }
+.w-13 { width:  3.25rem; }
+
+/* ================================================================
+   Hero de campaña — etiquetas colgadas del riel
+   ================================================================ */
+.hero-display {
+  font-family: var(--font-display);
+  letter-spacing: -0.02em;
+}
+
+/* Campaña: superficie pastel, sin textura */
+.hero-taller {
+  background-color: var(--campana);
+}
+
+/* La cuerda: del ojal de la etiqueta hasta el riel */
+.etiqueta {
+  position: relative;
+  transform-origin: 50% calc(var(--cuerda, 36px) * -1);
+  animation: etiqueta-balanceo 2.6s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
+  animation-delay: calc(var(--i, 0) * 160ms + 150ms);
+}
+.etiqueta::before {
+  content: "";
+  position: absolute;
+  left: 50%;
+  bottom: calc(100% - 6px);
+  width: 2px;
+  height: var(--cuerda, 36px);
+  background: var(--color-gold);
+  opacity: 0.8;
+  transform: translateX(-50%);
+}
+/* Un solo momento de movimiento: las etiquetas se balancean al cargar y se asientan */
+@keyframes etiqueta-balanceo {
+  0%   { transform: rotate(-9deg); }
+  20%  { transform: rotate(6deg); }
+  40%  { transform: rotate(-4deg); }
+  60%  { transform: rotate(2.5deg); }
+  80%  { transform: rotate(-1deg); }
+  100% { transform: rotate(0); }
+}
+/* Respuesta al pasar el mouse */
+.etiqueta:hover {
+  animation: etiqueta-roce 0.9s ease-in-out;
+}
+@keyframes etiqueta-roce {
+  0%, 100% { transform: rotate(0); }
+  35%      { transform: rotate(2.5deg); }
+  70%      { transform: rotate(-1.5deg); }
+}
+@media (prefers-reduced-motion: reduce) {
+  .etiqueta,
+  .etiqueta:hover {
+    animation: none;
+  }
+}
+
+.no-scrollbar { scrollbar-width: none; }
+.no-scrollbar::-webkit-scrollbar { display: none; }
+
+
+
+/* Animaciones de acceso (AuthButton). Pegar al final de src/styles.css */
+
+/* Brillo que cruza la pastilla "Iniciar sesión" */
+.auth-shine {
+  position: relative;
+  overflow: hidden;
+  isolation: isolate;
+}
+.auth-shine::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.35) 50%, transparent 65%);
+  transform: translateX(-120%);
+  animation: auth-sweep 4.5s ease-in-out 1.2s infinite;
+}
+.auth-shine:hover::after {
+  animation-duration: 1.4s;
+}
+@keyframes auth-sweep {
+  0%,
+  60% {
+    transform: translateX(-120%);
+  }
+  100% {
+    transform: translateX(120%);
+  }
+}
+
+/* Llave que se balancea como las etiquetas colgantes del hero */
+.auth-cta-icon {
+  transform-origin: 50% 0;
+  animation: auth-sway 3.2s ease-in-out infinite;
+}
+.auth-cta:hover .auth-cta-icon {
+  animation-duration: 0.9s;
+}
+@keyframes auth-sway {
+  0%,
+  100% {
+    transform: rotate(-10deg);
+  }
+  50% {
+    transform: rotate(10deg);
+  }
+}
+
+/* Aparición del avatar tras un login exitoso */
+.auth-pop {
+  animation: auth-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
+}
+@keyframes auth-pop {
+  0% {
+    transform: scale(0.4);
+    opacity: 0;
+  }
+  70% {
+    transform: scale(1.12);
+    opacity: 1;
+  }
+  100% {
+    transform: scale(1);
+  }
+}
+
+/* Aro que se expande alrededor del avatar */
+.auth-ring {
+  border: 2px solid var(--color-accent, currentColor);
+  animation: auth-ring 1.4s ease-out 0.2s 2 both;
+}
+@keyframes auth-ring {
+  0% {
+    transform: scale(1);
+    opacity: 0.7;
+  }
+  100% {
+    transform: scale(1.9);
+    opacity: 0;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .auth-shine::after,
+  .auth-cta-icon,
+  .auth-pop,
+  .auth-ring {
+    animation: none;
+  }
+}
+
+/* ================================================================
+   Escala tipográfica (móvil / desktop ≥ 640 px)
+   título 32/48 · sección 26/32 · producto 15/16 · precio 18/20
+   texto 14/16 · botón 14 · apoyo 12 (mínimo de la tienda)
+   ================================================================ */
+@layer components {
+  .t-titulo   { font-family: var(--font-display); font-weight: 400; font-size: 32px; line-height: 1.15; letter-spacing: -0.02em; }
+  .t-seccion  { font-family: var(--font-display); font-weight: 400; font-size: 26px; line-height: 1.2; letter-spacing: -0.02em; }
+  .t-producto { font-family: var(--font-body); font-weight: 600; font-size: 15px; line-height: 1.3; }
+  .t-precio   { font-family: var(--font-body); font-weight: 700; font-size: 18px; line-height: 1.1; font-variant-numeric: tabular-nums; }
+  .t-precio-ficha { font-family: var(--font-body); font-weight: 700; font-size: 24px; line-height: 1.1; font-variant-numeric: tabular-nums; }
+  .t-texto    { font-family: var(--font-body); font-weight: 400; font-size: 14px; line-height: 1.6; }
+  .t-boton    { font-family: var(--font-body); font-weight: 600; font-size: 14px; }
+  .t-apoyo    { font-family: var(--font-body); font-weight: 500; font-size: 12px; line-height: 1.4; }
+  @media (min-width: 640px) {
+    .t-titulo   { font-size: 48px; }
+    .t-seccion  { font-size: 32px; }
+    .t-producto { font-size: 16px; }
+    .t-precio   { font-size: 20px; }
+    .t-precio-ficha { font-size: 28px; }
+    .t-texto    { font-size: 16px; }
+  }
+}
