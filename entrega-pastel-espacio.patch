+@layer base {
+  * {
+    border-color: var(--color-border);
+  }
+
+  html, body {
+    max-width: 100vw;
+    overflow-x: clip;
+  }
+
+  body {
+    background-color: var(--color-background);
+    color: var(--color-foreground);
+    font-family: var(--font-body);
+    font-feature-settings: "ss01", "ss02";
+  }
+
+  #root {
+    max-width: 100vw;
+    overflow-x: clip;
+  }
+
+  /* Serif solo en h1/h2 y en .font-display; h3/h4 son Inter (subtítulos y nombres de producto) */
+  h1, h2, .font-display {
+    font-family: var(--font-display);
+    font-weight: 400;
+    letter-spacing: -0.02em;
+  }
+  h3, h4 {
+    font-family: var(--font-body);
+    font-weight: 500;
+  }
+}
