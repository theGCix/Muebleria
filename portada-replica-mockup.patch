@@ -0,0 +1,35 @@
+// src/hooks/usePiezasPorTramo.ts
+// Diapositivas del banner del home: una pieza real por tramo de presupuesto (la de mayor precio final que
+// tiene foto). Misma consulta y caché que el catálogo del home: no agrega peticiones.
+import { useMemo } from "react";
+import { useCatalogoHome } from "@/hooks/useCatalogoHome";
+import { TRAMOS, precioEnRango, type Tramo } from "@/lib/presupuesto";
+import { piezasPorTramo } from "@/lib/portada";
+import type { PiezaEscena } from "@/components/EscenaPortada";
+import { cloudinaryUrl } from "@/lib/cloudinary";
+import { ofertaInfo } from "@/lib/pricing";
+
+export interface DiapositivaPortada {
+  tramo: Tramo;
+  pieza: PiezaEscena;
+}
+
+export function usePiezasPorTramo() {
+  const { data, isLoading } = useCatalogoHome(60);
+
+  const diapositivas = useMemo<DiapositivaPortada[]>(() => {
+    if (!data) return [];
+    const candidatas = data.map((p) => ({
+      id: p.id,
+      nombre: p.nombre,
+      precioFinal: ofertaInfo(p).precioFinal,
+      foto: p.imagen_public_id ? cloudinaryUrl(p.imagen_public_id, { w: 720 }) : (p.imagen_url as string | null),
+    }));
+    return piezasPorTramo(candidatas, TRAMOS, (n, t) => precioEnRango(n, t)).map(({ tramo, pieza }) => ({
+      tramo,
+      pieza: { id: pieza.id, nombre: pieza.nombre, precioFinal: pieza.precioFinal, src: pieza.foto as string },
+    }));
+  }, [data]);
+
+  return { diapositivas, cargando: isLoading };
+}
diff --git a/src/lib/portada.ts b/src/lib/portada.ts
index 489fb35..bf0235b 100644
--- a/src/lib/portada.ts
+++ b/src/lib/portada.ts
@@ -33,3 +33,31 @@ export function tramoInicial<T extends { id: string }>(tramos: readonly T[]): T
   if (tramos.length === 0) return null;
   return tramos[Math.min(1, tramos.length - 1)];
 }
+
+export interface SlidePortada<T, R> {
+  tramo: R;
+  pieza: T;
+}
+
+/**
+ * Carrusel del banner: una pieza por tramo de presupuesto (la mejor con foto, ver `elegirPiezaEscena`).
+ * Un tramo sin pieza con foto no genera diapositiva (no se inventa nada). Respeta el orden de `tramos`.
+ */
+export function piezasPorTramo<T extends CandidataEscena, R extends { min: number | null; max: number | null }>(
+  piezas: readonly T[],
+  tramos: readonly R[],
+  enTramo: (precioFinal: number, tramo: R) => boolean,
+): SlidePortada<T, R>[] {
+  const out: SlidePortada<T, R>[] = [];
+  for (const tramo of tramos) {
+    const pieza = elegirPiezaEscena(piezas, (n) => enTramo(n, tramo));
+    if (pieza) out.push({ tramo, pieza });
+  }
+  return out;
+}
+
+/** Siguiente / anterior posición del carrusel, dando la vuelta en los extremos. Con 0 o 1 diapositivas siempre 0. */
+export function moverIndice(actual: number, paso: 1 | -1, total: number): number {
+  if (total <= 1) return 0;
+  return (((actual + paso) % total) + total) % total;
+}
