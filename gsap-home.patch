+  ok: "(prefers-reduced-motion: no-preference)",
+  /** Escritorio con alto suficiente para una sección fijada (pin) completa */
+  pin: "(min-width: 1024px) and (min-height: 760px) and (prefers-reduced-motion: no-preference)",
+} as const;
