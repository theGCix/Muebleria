+/* src/components/product/product-breadcrumb.css
+   Ruta de compra de la ficha de producto. Usa los tokens --gm-* de la página (con respaldo). */
+
+.gmb {
+  --b-walnut: var(--gm-walnut, #3b2b1f);
+  --b-mid: var(--gm-mid, #5a4035);
+  --b-gold: var(--gm-gold, #c9a96e);
+  --b-line: var(--gm-border, rgba(59, 43, 31, .12));
+  --b-hover: rgba(59, 43, 31, .07);
+  max-width: 1300px;
+  margin: 0 auto;
+  padding: 14px 48px 4px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 14px;
+  font-size: 13px;
+  line-height: 1;
+}
+
+.gmb-nav { min-width: 0; flex: 1 1 auto; }
+
+/* ───────── Recorrido ───────── */
+.gmb-trail {
+  list-style: none; margin: 0; padding: 3px;
+  display: inline-flex; align-items: center; max-width: 100%;
+  background: rgba(255, 253, 249, .85);
+  border: 1px solid var(--b-line);
+  border-radius: 9999px;
+  box-shadow: 0 8px 22px -18px rgba(60, 35, 15, .5);
+}
+.gmb-trail > li { display: flex; align-items: center; position: relative; min-width: 0; }
+
+.gmb-chip {
+  display: inline-flex; align-items: center; gap: 7px;
+  height: 36px; padding: 0 13px; border-radius: 9999px;
+  color: var(--b-mid); text-decoration: none; font-weight: 500;
+  transition: background-color .18s, color .18s;
+}
+.gmb-chip:hover { background: var(--b-hover); color: var(--b-walnut); }
+.gmb-chip-plain { cursor: default; }
+.gmb-chip-plain:hover { background: none; }
+.gmb-chip svg { flex: none; }
+
+.gmb-cut { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+/* Separador: una pequeña diagonal en lugar de un chevron */
+.gmb-sep { width: 1px; height: 16px; margin: 0 2px; flex: none; background: var(--b-line); transform: rotate(18deg); }
+
+/* Categoría = enlace + botón de menú pegados */
+.gmb-split { display: inline-flex; align-items: center; min-width: 0; }
+.gmb-chip-cat { padding-right: 6px; min-width: 0; }
+.gmb-caret {
+  display: inline-flex; align-items: center; justify-content: center;
+  width: 30px; height: 30px; margin-right: 3px; flex: none;
+  border: 0; border-radius: 9999px; background: none; color: var(--b-mid); cursor: pointer;
+  transition: background-color .18s, color .18s;
+}
+.gmb-caret:hover, .gmb-caret[aria-expanded="true"] { background: var(--b-hover); color: var(--b-walnut); }
+.gmb-caret svg { transition: transform .2s; }
+.gmb-caret svg[data-abierto="true"] { transform: rotate(180deg); }
+
+/* Pieza actual */
+.gmb-now { gap: 9px; padding: 0 14px 0 10px; height: 36px; color: var(--b-walnut); font-weight: 600; }
+.gmb-now-name { max-width: 34ch; }
+.gmb-dot { flex: none; width: 7px; height: 7px; border-radius: 9999px; background: var(--b-gold); box-shadow: 0 0 0 3px rgba(201, 169, 110, .22); }
+
+/* ───────── Menú "Seguir explorando" ───────── */
+.gmb-menu {
+  position: absolute; z-index: 30; left: 0; top: calc(100% + 10px);
+  width: 270px; padding: 8px;
+  background: #fffdf9; border: 1px solid var(--b-line); border-radius: 18px;
+  box-shadow: 0 24px 48px -20px rgba(60, 35, 15, .45);
+  transform-origin: 24px -6px;
+  animation: gmb-open .16s ease-out;
+}
+.gmb-menu ul { list-style: none; margin: 0; padding: 0; }
+.gmb-menu-title { margin: 6px 10px 6px; font-size: 12px; font-weight: 600; color: var(--b-mid); }
+.gmb-opt {
+  display: flex; align-items: center; gap: 10px; padding: 11px 10px; border-radius: 12px;
+  color: var(--b-walnut); text-decoration: none; font-weight: 500;
+  transition: background-color .15s;
+}
+.gmb-opt:hover { background: var(--b-hover); }
+.gmb-opt[aria-current="true"] { background: rgba(201, 169, 110, .18); }
+.gmb-opt-ok { margin-left: auto; color: var(--b-walnut); }
+.gmb-all {
+  display: block; margin-top: 4px; padding: 12px 10px 8px; border-top: 1px solid var(--b-line);
+  color: var(--b-mid); text-decoration: none; font-weight: 500; text-align: center;
+}
+.gmb-all:hover { color: var(--b-walnut); text-decoration: underline; text-underline-offset: 3px; }
+
+@keyframes gmb-open { from { opacity: 0; transform: translateY(-4px) scale(.97); } to { opacity: 1; transform: none; } }
+
+/* ───────── Pieza 3 de 8 ───────── */
+.gmb-pager {
+  flex: none; display: inline-flex; align-items: center; gap: 2px; padding: 3px;
+  background: rgba(255, 253, 249, .85); border: 1px solid var(--b-line); border-radius: 9999px;
+  box-shadow: 0 8px 22px -18px rgba(60, 35, 15, .5);
+}
+.gmb-count { padding: 0 6px; color: var(--b-mid); font-variant-numeric: tabular-nums; white-space: nowrap; }
+.gmb-count b { color: var(--b-walnut); font-weight: 700; }
+
+.gmb-step {
+  position: relative; display: inline-flex; align-items: center; justify-content: center;
+  width: 36px; height: 36px; border-radius: 9999px; color: var(--b-walnut); text-decoration: none;
+  transition: background-color .18s;
+}
+.gmb-step:hover, .gmb-step:focus-visible { background: var(--b-walnut); color: #fffdf9; }
+
+/* Vista previa de la pieza vecina */
+.gmb-peek {
+  position: absolute; z-index: 30; top: calc(100% + 10px); width: 250px; padding: 8px;
+  display: none; gap: 12px; align-items: center; text-align: left; line-height: 1.25;
+  background: #fffdf9; color: var(--b-walnut);
+  border: 1px solid var(--b-line); border-radius: 16px;
+  box-shadow: 0 24px 48px -20px rgba(60, 35, 15, .45);
+  pointer-events: none;
+}
+.gmb-peek[data-lado="anterior"] { right: -40px; }
+.gmb-peek[data-lado="siguiente"] { right: 0; }
+.gmb-step:hover .gmb-peek, .gmb-step:focus-visible .gmb-peek { display: flex; animation: gmb-open .16s ease-out; }
+.gmb-peek-img { flex: none; width: 58px; height: 58px; border-radius: 12px; overflow: hidden; background: #f3eadc; }
+.gmb-peek-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
+.gmb-peek-txt { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
+.gmb-peek-eyebrow { font-size: 11px; color: var(--b-mid); }
+.gmb-peek-name { font-size: 13px; font-weight: 600; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+.gmb-peek-price { font-size: 13px; color: var(--b-mid); font-variant-numeric: tabular-nums; }
+
+/* Foco visible para teclado */
+.gmb-chip:focus-visible, .gmb-caret:focus-visible, .gmb-opt:focus-visible, .gmb-all:focus-visible, .gmb-step:focus-visible {
+  outline: 2px solid var(--b-gold); outline-offset: 2px;
+}
+
+/* ───────── Móvil: una sola línea ───────── */
+@media (hover: none) { .gmb-peek { display: none !important; } }
+
+@media (max-width: 768px) {
+  .gmb { padding: 12px 16px 2px; gap: 8px; }
+  .gmb-hide-sm { display: none; }
+  .gmb-chip { padding: 0 11px; }
+  .gmb-chip[aria-label="Inicio"] { width: 36px; padding: 0; justify-content: center; }
+  .gmb-chip-cat { max-width: calc(100vw - 235px); }
+  /* El nombre del producto ya es el título de la página: se queda para lectores de pantalla */
+  .gmb-trail > .gmb-sep-now { display: none; }
+  .gmb-trail > .gmb-now { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
+  .gmb-menu { width: min(270px, calc(100vw - 32px)); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .gmb-menu, .gmb-peek { animation: none !important; }
+  .gmb-caret svg { transition: none; }
+}
