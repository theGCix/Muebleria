+
+                <div className="space-y-1.5">
+                  <Label>Vista previa</Label>
+                  {producto && descuento && precioFinal !== null && form.imagen_url ? (
+                    <BannerLiquidacion
+                      className="aspect-[4/3] w-full max-w-sm"
