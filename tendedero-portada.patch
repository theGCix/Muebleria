+// src/components/home/TendederoPiezas.tsx
+// Las piezas de la portada colgadas de una cuerda con pinzas, como fotos en un tendedero (boceto aprobado).
+//  · PC: una cuerda con hasta 3 piezas, bien separadas y casi al unísono para que no se tapen al balancearse.
+//  · Móvil: dos cuerdas cortas, una pieza en cada una (solo el precio, sin nombre).
+// Cada pieza es un péndulo (lib/tendedero.ts): se mece sola, se inclina con el celular, reacciona a sacudidas y
+// al toque (hooks/useInclinacion.ts). Con «reducir movimiento» queda quieta y apenas ladeada. Cada pieza sigue
+// siendo un enlace a su ficha.
+import { useEffect, useRef, type ReactNode } from "react";
+import { Link } from "@tanstack/react-router";
+import { Sofa } from "lucide-react";
+import { alTocar, empujar, inclinacion, useInclinacion } from "@/hooks/useInclinacion";
+import {
+  caida,
+  disposicionPC,
+  DISPOSICION_MOVIL,
+  paramsPendulo,
+  pasoPendulo,
+  type Aspecto,
+} from "@/lib/tendedero";
+
+export interface PiezaColgante {
+  src: string | null;
+  nombre: string;
+  id?: string;
+  precio: string | null;
+}
+
+const ASPECTO: Record<Aspecto, string> = {
+  "4/5": "aspect-[4/5]",
+  "7/10": "aspect-[7/10]",
+  "4/3": "aspect-[4/3]",
+};
+
+function Colgante({ indice, pc, children }: { indice: number; pc: boolean; children: ReactNode }) {
+  const ref = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    const el = ref.current;
+    if (!el) return;
+    const inicial = indice % 2 === 0 ? -1.5 : 1.5;
+    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
+      el.style.transform = `rotate(${inicial}deg)`;
+      return;
+    }
+
+    const par = paramsPendulo(indice, pc);
+    const e = { a: inicial, v: 0 };
+    let golpeVisto = inclinacion.golpe.n;
+    let anterior = performance.now();
+    let raf = 0;
+    let timer = 0;
+    let vivo = true;
+
+    const paso = (ahora: number) => {
+      if (!vivo) return;
+      // Pestaña oculta, versión no visible (PC/móvil) o diapositiva inactiva: se duerme y se revisa de vez en cuando.
+      if (document.hidden || el.offsetParent === null || el.closest('[role="tabpanel"][aria-hidden="true"]')) {
+        anterior = performance.now();
+        timer = window.setTimeout(() => {
+          raf = requestAnimationFrame(paso);
+        }, 400);
+        return;
+      }
+      const dt = Math.min((ahora - anterior) / 1000, 0.032);
+      anterior = ahora;
+      if (inclinacion.golpe.n !== golpeVisto) {
+        golpeVisto = inclinacion.golpe.n;
+        e.v += inclinacion.golpe.fuerza * par.s * par.g;
+      }
+      pasoPendulo(e, par, inclinacion.objetivo, ahora / 1000, dt);
+      el.style.transform = `rotate(${e.a.toFixed(2)}deg)`;
+      raf = requestAnimationFrame(paso);
+    };
+    raf = requestAnimationFrame(paso);
+
+    return () => {
+      vivo = false;
+      cancelAnimationFrame(raf);
+      window.clearTimeout(timer);
+    };
+  }, [indice, pc]);
+
+  return (
+    <div ref={ref} className="relative origin-top will-change-transform">
+      {[24, 76].map((x) => (
+        <span
+          key={x}
+          aria-hidden
+          style={{ left: `${x}%` }}
+          className="absolute -top-2 z-10 h-4 w-[9px] -translate-x-1/2 rounded-[2px] border border-gm-cafe/60 bg-gm-madera after:absolute after:inset-x-0 after:top-1/2 after:h-px after:bg-gm-cafe/60 after:content-['']"
+        />
+      ))}
+      {children}
+    </div>
+  );
+}
+
+function Marco({ pieza, aspecto, pc }: { pieza: PiezaColgante; aspecto: Aspecto; pc: boolean }) {
+  const cls =
+    "block rounded-lg bg-cream p-1.5 pb-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-gm-bosque";
+  const contenido = (
+    <>
+      <span className={`relative block w-full overflow-hidden rounded bg-gm-arena ${ASPECTO[aspecto]}`}>
+        {pieza.src ? (
+          <img
+            src={pieza.src}
+            alt={pieza.nombre}
+            width={720}
+            height={540}
+            loading="lazy"
+            draggable={false}
+            className="h-full w-full object-cover"
+          />
+        ) : (
+          <span aria-hidden className="flex h-full w-full items-center justify-center text-gm-cafe/50">
+            <Sofa className="h-1/3 w-1/3" />
+          </span>
+        )}
+      </span>
+      {pc && (
+        <span className="mt-2 block truncate px-0.5 text-xs font-medium leading-tight text-gm-carbon lg:text-sm">
+          {pieza.nombre}
+        </span>
+      )}
+      {pieza.precio && (
+        <span className="mt-0.5 block px-0.5 text-xs text-gm-terracota lg:text-sm">{pieza.precio}</span>
+      )}
+    </>
+  );
+  return pieza.id ? (
+    <Link to="/product/$handle" params={{ handle: pieza.id }} className={cls}>
+      {contenido}
+    </Link>
+  ) : (
+    <div className={cls}>{contenido}</div>
+  );
+}
+
+/**
+ * Una cuerda con sus piezas. `className` la coloca dentro de la diapositiva (posición absoluta). En móvil se usa una
+ * cuerda por pieza: `indice` (0 o 1) elige su disposición y su ritmo.
+ */
+export function TendederoPiezas({
+  piezas,
+  variante,
+  indice = 0,
+  className = "",
+}: {
+  piezas: PiezaColgante[];
+  variante: "pc" | "movil";
+  indice?: 0 | 1;
+  className?: string;
+}) {
+  useInclinacion();
+  const pc = variante === "pc";
+  const sag = pc ? 10 : 6;
+  const huecos = pc ? disposicionPC(piezas.length) : [DISPOSICION_MOVIL[indice]];
+  const curva = `M0 3 Q50 ${3 + 2 * sag} 100 3`;
+
+  return (
+    <div className={`absolute z-[5] h-8 ${className}`}>
+      {/* Cuerda de pita */}
+      <svg
+        aria-hidden
+        viewBox="0 0 100 30"
+        preserveAspectRatio="none"
+        className="pointer-events-none absolute left-0 top-0 h-[30px] w-full overflow-visible"
+      >
+        <path d={curva} fill="none" strokeWidth="2.4" strokeLinecap="round" vectorEffect="non-scaling-stroke" className="stroke-gm-pita" />
+        <path d={curva} fill="none" strokeWidth="1.6" strokeDasharray="2 4" vectorEffect="non-scaling-stroke" className="stroke-gm-madera" />
+      </svg>
+      <span aria-hidden className="absolute -left-1 -top-px h-[9px] w-[9px] rounded-full border border-gm-madera bg-gm-pita" />
+      {/* Zona táctil de la cuerda: empuja y, en iPhone, pide el permiso del movimiento */}
+      <div aria-hidden className="absolute inset-x-0 -top-3 h-8 [touch-action:manipulation]" onPointerDown={alTocar} />
+
+      {huecos.map((h, i) => {
+        const pieza = piezas[i];
+        if (!pieza) return null;
+        const t = h.x + h.w / 2;
+        return (
+          <div
+            key={`${pieza.id ?? pieza.nombre}-${i}`}
+            className="absolute select-none"
+            style={{ left: `${h.x * 100}%`, width: `${h.w * 100}%`, top: caida(t, sag) + 4 }}
+            onPointerDown={empujar}
+          >
+            <Colgante indice={pc ? i : indice} pc={pc}>
+              <Marco pieza={pieza} aspecto={h.aspecto} pc={pc} />
+            </Colgante>
+          </div>
+        );
+      })}
+    </div>
+  );
+}
diff --git a/src/hooks/useInclinacion.ts b/src/hooks/useInclinacion.ts
new file mode 100644
index 0000000..331a211
--- /dev/null
+++ b/src/hooks/useInclinacion.ts
@@ -0,0 +1,124 @@
+// src/hooks/useInclinacion.ts
+// Estado compartido para las piezas colgantes del tendedero de la portada (TendederoPiezas).
+//  · `inclinacion.objetivo`: ángulo (°) hacia el que tiende lo que cuelga según la inclinación del celular.
+//  · `inclinacion.golpe`: empujón (sacudida del celular o toque). `n` cambia en cada golpe; `fuerza` es °/s.
+// Un solo par de escuchas (deviceorientation / devicemotion) sirve a todas las cuerdas: se cuentan los usos y se
+// quitan al desmontar la última. Android/Chrome funciona directo (HTTPS); iPhone/Safari pide permiso con un toque
+// (`alTocar`). Respeta «reducir movimiento» (no escucha nada).
+import { useEffect, type PointerEvent } from "react";
+import { anguloInclinacion } from "@/lib/tendedero";
+
+type ConPermiso = { requestPermission?: () => Promise<"granted" | "denied"> };
+
+export const inclinacion = {
+  objetivo: 0,
+  golpe: { n: 0, fuerza: 0 },
+};
+
+const MAX_FUERZA = 140; // °/s: recorte de empujones y sacudidas fuertes
+const ZONA_MUERTA = 1.2; // m/s²: ignora el temblor normal de la mano
+const ENTRE_GOLPES_MS = 90;
+
+let usos = 0;
+let quitar: (() => void) | null = null;
+let ultimoGolpe = 0;
+let permisoPedido = false;
+
+const reducirMovimiento = () =>
+  typeof window !== "undefined" && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+
+const anguloPantalla = () =>
+  window.screen?.orientation?.angle ?? (window as unknown as { orientation?: number }).orientation ?? 0;
+
+function golpear(fuerza: number) {
+  const ahora = performance.now();
+  if (ahora - ultimoGolpe < ENTRE_GOLPES_MS) return;
+  ultimoGolpe = ahora;
+  inclinacion.golpe.fuerza = Math.max(-MAX_FUERZA, Math.min(MAX_FUERZA, fuerza));
+  inclinacion.golpe.n += 1;
+}
+
+/** Aceleración lateral respecto a la pantalla (igual que useSacudida): en vertical es `x`. */
+function lateral(x: number, y: number): number {
+  const ang = ((anguloPantalla() % 360) + 360) % 360;
+  if (ang === 90) return y;
+  if (ang === 180) return -x;
+  if (ang === 270) return -y;
+  return x;
+}
+
+function escuchar() {
+  const g = { x: 0, y: 0 }; // gravedad estimada, solo si el equipo no entrega `acceleration`
+
+  const onOrientacion = (e: DeviceOrientationEvent) => {
+    inclinacion.objetivo = anguloInclinacion(e.gamma, anguloPantalla());
+  };
+
+  const onMovimiento = (e: DeviceMotionEvent) => {
+    let x = e.acceleration?.x;
+    let y = e.acceleration?.y;
+    if (x == null || y == null) {
+      const a = e.accelerationIncludingGravity;
+      if (!a || a.x == null || a.y == null) return;
+      g.x = 0.8 * g.x + 0.2 * a.x;
+      g.y = 0.8 * g.y + 0.2 * a.y;
+      x = a.x - g.x;
+      y = a.y - g.y;
+    }
+    const a = lateral(x, y);
+    if (Math.abs(a) < ZONA_MUERTA) return;
+    golpear(-a * 6); // el empujón va hacia el lado contrario a la aceleración
+  };
+
+  window.addEventListener("deviceorientation", onOrientacion);
+  window.addEventListener("devicemotion", onMovimiento);
+  return () => {
+    window.removeEventListener("deviceorientation", onOrientacion);
+    window.removeEventListener("devicemotion", onMovimiento);
+    inclinacion.objetivo = 0;
+  };
+}
+
+/** Activa las escuchas mientras haya al menos una cuerda montada. */
+export function useInclinacion() {
+  useEffect(() => {
+    if (typeof window === "undefined" || reducirMovimiento()) return;
+    if (!("DeviceOrientationEvent" in window) && !("DeviceMotionEvent" in window)) return;
+    // iPhone: sin permiso concedido los eventos no llegan; escuchar no cuesta nada y empiezan al conceder.
+    usos += 1;
+    if (usos === 1) quitar = escuchar();
+    return () => {
+      usos -= 1;
+      if (usos === 0) {
+        quitar?.();
+        quitar = null;
+      }
+    };
+  }, []);
+}
+
+/** Empuja la pieza tocada: hacia el lado contrario al punto del toque (más lejos del centro, más fuerte). */
+export function empujar(e: PointerEvent<HTMLElement>) {
+  if (reducirMovimiento()) return;
+  const r = e.currentTarget.getBoundingClientRect();
+  if (!r.width) return;
+  const dx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2); // -1 a 1
+  golpear(-Math.max(-1, Math.min(1, dx)) * 90 || 60); // toque justo al centro: empuje fijo
+}
+
+/** Toque sobre la cuerda: empuja y, en iPhone, pide el permiso de movimiento (debe ir dentro del toque). */
+export function alTocar(e: PointerEvent<HTMLElement>) {
+  if (reducirMovimiento()) return;
+  empujar(e);
+  if (permisoPedido || typeof window === "undefined") return;
+  const pedir = [
+    (window.DeviceOrientationEvent as unknown as ConPermiso | undefined)?.requestPermission,
+    (window.DeviceMotionEvent as unknown as ConPermiso | undefined)?.requestPermission,
+  ].filter((f): f is NonNullable<typeof f> => typeof f === "function");
+  if (!pedir.length) return;
+  permisoPedido = true;
+  void Promise.allSettled([
+    (window.DeviceOrientationEvent as unknown as ConPermiso).requestPermission?.(),
+    (window.DeviceMotionEvent as unknown as ConPermiso).requestPermission?.(),
+  ]);
+}
diff --git a/src/lib/tendedero.ts b/src/lib/tendedero.ts
new file mode 100644
index 0000000..934efd3
--- /dev/null
+++ b/src/lib/tendedero.ts
@@ -0,0 +1,83 @@
+// src/lib/tendedero.ts
+// Lógica pura del tendedero de la portada (las piezas cuelgan de una cuerda con pinzas). Sin imports del proyecto
+// para poder probarla con `node scripts/test-tendedero.mjs`.
+
+export type Aspecto = "4/5" | "7/10" | "4/3";
+
+/** Lugar de una pieza sobre la cuerda: `x` y `w` son fracciones (0-1) del ancho de la cuerda. */
+export interface Hueco {
+  x: number;
+  w: number;
+  aspecto: Aspecto;
+}
+
+const clamp = (n: number, min: number, max: number) => Math.min(max, Math.max(min, n));
+
+/** Cuánto baja la cuerda (px) en la posición `t` (0 a 1): parábola, 0 en los extremos y `sag` en el centro. */
+export function caida(t: number, sag: number): number {
+  return Math.round(sag * 4 * t * (1 - t));
+}
+
+/** PC: una cuerda con hasta 3 piezas, bien separadas para que no se tapen al balancearse (≥ 11 % de aire). */
+export function disposicionPC(n: number): Hueco[] {
+  if (n >= 3)
+    return [
+      { x: 0.02, w: 0.24, aspecto: "4/5" },
+      { x: 0.37, w: 0.26, aspecto: "7/10" },
+      { x: 0.74, w: 0.24, aspecto: "4/5" },
+    ];
+  if (n === 2)
+    return [
+      { x: 0.12, w: 0.3, aspecto: "4/5" },
+      { x: 0.56, w: 0.3, aspecto: "7/10" },
+    ];
+  if (n === 1) return [{ x: 0.36, w: 0.28, aspecto: "7/10" }];
+  return [];
+}
+
+/** Móvil: dos cuerdas cortas, una pieza en cada una. */
+export const DISPOSICION_MOVIL: readonly [Hueco, Hueco] = [
+  { x: 0.1, w: 0.68, aspecto: "4/3" },
+  { x: 0.14, w: 0.64, aspecto: "4/3" },
+];
+
+/**
+ * Ángulo objetivo (°) de lo que cuelga según la inclinación del celular (`gamma` de deviceorientation).
+ * Cuelga hacia el lado contrario a la inclinación. Solo en vertical (0° o 180°): en horizontal los ejes cambian.
+ */
+export function anguloInclinacion(gamma: number | null, pantalla: number, max = 18): number {
+  if (gamma == null || !Number.isFinite(gamma)) return 0;
+  const a = ((pantalla % 360) + 360) % 360;
+  const base = a === 0 ? -gamma * 0.5 : a === 180 ? gamma * 0.5 : 0;
+  return clamp(base, -max, max) + 0;
+}
+
+export interface ParamsPendulo {
+  k: number; // rigidez del resorte
+  c: number; // amortiguación
+  s: number; // sensibilidad a la inclinación
+  g: number; // ganancia de los empujones
+  lim: number; // ángulo máximo (°)
+  fase: number;
+  w: number; // frecuencia del vaivén de reposo (rad/s)
+}
+
+/** PC: las tres piezas casi iguales (se mueven al unísono y no se cruzan). Móvil: cada una a su ritmo. */
+export function paramsPendulo(i: number, pc: boolean): ParamsPendulo {
+  return pc
+    ? { k: 18 + (i % 3), c: 1.7, s: 1, g: 0.5, lim: 18, fase: i * 0.35, w: 0.8 }
+    : { k: 15 + (i % 3) * 5, c: 1.5 + (i % 2) * 0.5, s: 0.85 + (i % 4) * 0.1, g: 1, lim: 40, fase: i * 1.7, w: 0.7 + (i % 3) * 0.12 };
+}
+
+export interface EstadoPendulo {
+  a: number; // ángulo (°)
+  v: number; // velocidad (°/s)
+}
+
+/** Un paso del péndulo (resorte amortiguado hacia el objetivo + vaivén de reposo). `tSeg` = tiempo en segundos. */
+export function pasoPendulo(e: EstadoPendulo, p: ParamsPendulo, objetivo: number, tSeg: number, dt: number): void {
+  const reposo = Math.sin(tSeg * p.w + p.fase) * 1.3;
+  const meta = objetivo * p.s + reposo;
+  e.v += (-p.k * (e.a - meta) - p.c * e.v) * dt;
+  e.a = clamp(e.a + e.v * dt, -p.lim, p.lim);
+}
