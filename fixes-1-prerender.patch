@@ -0,0 +1,250 @@
+// scripts/prerender-lib.mjs
+// Funciones PURAS (sin red ni disco) para el prerenderizado. Las usa scripts/prerender.mjs.
+//
+// Idea: a partir de dist/index.html (la "carcasa" de la SPA) se genera una copia por página con
+// título, metas, canonical, JSON-LD y un resumen en <noscript>, para que los rastreadores que NO
+// ejecutan JavaScript (WhatsApp, Facebook, buscadores de IA, etc.) vean el contenido real.
+// Cuando la app arranca, src/lib/head.ts retoma el control del <head> sin dejar nada duplicado:
+//   · las etiquetas NUEVAS llevan data-gm-head="1"  → head.ts las borra y las vuelve a crear;
+//   · las metas que YA existían en index.html se editan en sitio y guardan su valor original en
+//     data-gm-orig → head.ts lo restaura y aplica la capa de la página (igual que hoy).
+
+export const MARK = 'data-gm-head="1"';
+
+/** Escapa texto/atributos HTML sin volver a escapar entidades que ya existan (&amp;, &#39;…). */
+export const esc = (v) =>
+  String(v ?? "")
+    .replace(/&(?!(?:amp|lt|gt|quot|#\d+|#x[0-9a-f]+);)/gi, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+
+export const recortar = (t, n = 160) => {
+  const s = String(t ?? "").replace(/\s+/g, " ").trim();
+  return s.length > n ? `${s.slice(0, n - 1).trimEnd()}…` : s;
+};
+
+const reEsc = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+
+/** Busca <meta name|property="clave" ...>. */
+function buscarMeta(html, clave) {
+  return html.match(new RegExp(`<meta\\s+[^>]*?(?:name|property)="${reEsc(clave)}"[^>]*?>`, "i"));
+}
+
+/** Cambia el content de una meta existente (guardando el original) o devuelve una nueva para añadir. */
+function fijarMeta(html, extras, tipo, clave, contenido) {
+  if (!contenido) return html;
+  const m = buscarMeta(html, clave);
+  if (m) {
+    const etiqueta = m[0];
+    const original = (etiqueta.match(/content="([^"]*)"/i) ?? [])[1] ?? "";
+    let nueva = etiqueta.replace(/content="[^"]*"/i, `content="${esc(contenido)}"`);
+    if (!/data-gm-orig=/.test(nueva)) nueva = nueva.replace(/^<meta/i, `<meta data-gm-orig="${original}"`);
+    return html.replace(etiqueta, nueva);
+  }
+  extras.push(`<meta ${tipo}="${esc(clave)}" content="${esc(contenido)}" ${MARK} />`);
+  return html;
+}
+
+const quitarMeta = (html, clave) => {
+  const m = buscarMeta(html, clave);
+  return m ? html.replace(m[0], "") : html;
+};
+
+/**
+ * Devuelve el HTML de una página a partir de la carcasa.
+ * page = { title, description, canonical, image?, type?, jsonLd?: object[], noscript?: string, noindex?: boolean }
+ */
+export function inyectar(plantilla, page) {
+  let html = plantilla;
+  const extras = [];
+
+  // Título: se conserva el original en <html data-gm-base-title> para que head.ts lo use como base.
+  const t = html.match(/<title>([\s\S]*?)<\/title>/i);
+  if (t && page.title) {
+    if (!/data-gm-base-title=/.test(html)) html = html.replace(/<html\b/i, `<html data-gm-base-title="${esc(t[1])}"`);
+    html = html.replace(/<title>[\s\S]*?<\/title>/i, `<title>${esc(page.title)}</title>`);
+  }
+
+  const desc = page.description ? recortar(page.description) : "";
+  html = fijarMeta(html, extras, "name", "description", desc);
+  html = fijarMeta(html, extras, "property", "og:title", page.title);
+  html = fijarMeta(html, extras, "property", "og:description", desc);
+  html = fijarMeta(html, extras, "property", "og:type", page.type);
+  html = fijarMeta(html, extras, "property", "og:url", page.canonical);
+  html = fijarMeta(html, extras, "name", "twitter:title", page.title);
+  html = fijarMeta(html, extras, "name", "twitter:description", desc);
+  if (page.image) {
+    html = fijarMeta(html, extras, "property", "og:image", page.image);
+    html = fijarMeta(html, extras, "name", "twitter:image", page.image);
+    // Las medidas/alt de index.html describen la imagen por defecto, no la del producto
+    for (const k of ["og:image:width", "og:image:height", "og:image:alt"]) html = quitarMeta(html, k);
+  }
+  if (page.noindex) extras.push(`<meta name="robots" content="noindex, nofollow" ${MARK} />`);
+
+  html = html.replace(/<link\s+[^>]*rel="canonical"[^>]*>/i, "");
+  if (page.canonical) extras.push(`<link rel="canonical" href="${esc(page.canonical)}" ${MARK} />`);
+
+  for (const ld of page.jsonLd ?? []) {
+    // "<" escapado para que un texto con "</script>" no cierre la etiqueta
+    extras.push(`<script type="application/ld+json" ${MARK}>${JSON.stringify(ld).replace(/</g, "\\u003c")}</script>`);
+  }
+
+  if (extras.length) html = html.replace(/<\/head>/i, `    ${extras.join("\n    ")}\n  </head>`);
+  if (page.noscript) html = html.replace(/<div id="root"><\/div>/i, `<noscript>${page.noscript}</noscript>\n    <div id="root"></div>`);
+  return html;
+}
+
+/* ───────── contenido <noscript> ───────── */
+
+const soles = (n) => `S/ ${Number(n).toLocaleString("es-PE", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
+
+const enlaces = (items) =>
+  items.length ? `<ul>${items.map((i) => `<li><a href="${esc(i.href)}">${esc(i.texto)}</a></li>`).join("")}</ul>` : "";
+
+const NAV = [
+  { href: "/", texto: "Inicio" },
+  { href: "/catalogo", texto: "Catálogo" },
+  { href: "/nosotros", texto: "Nuestro taller" },
+  { href: "/envios", texto: "Envíos y entregas" },
+  { href: "/testimonios", texto: "Testimonios" },
+];
+
+export function noscriptProducto({ nombre, descripcion, precio, precioOriginal, categoria, imagenes, sitio }) {
+  return (
+    `<main><nav>${enlaces([...NAV.slice(0, 2), ...(categoria ? [{ href: `/categoria/${categoria.slug}`, texto: categoria.nombre }] : [])])}</nav>` +
+    `<h1>${esc(nombre)}</h1>` +
+    (imagenes[0] ? `<img src="${esc(imagenes[0])}" alt="${esc(nombre)}" width="600" />` : "") +
+    `<p>${esc(soles(precio))}${precioOriginal ? ` (antes ${esc(soles(precioOriginal))})` : ""}</p>` +
+    (descripcion ? `<p>${esc(descripcion)}</p>` : "") +
+    `<p>Mueble fabricado a pedido en Lima por G&amp;M Mueblería, con entrega a domicilio.</p>` +
+    `<p><a href="${esc(sitio)}/catalogo">Ver todo el catálogo</a></p></main>`
+  );
+}
+
+export function noscriptCombo({ nombre, descripcion, precio, piezas, imagen }) {
+  return (
+    `<main><nav>${enlaces(NAV.slice(0, 2))}</nav><h1>${esc(nombre)}</h1>` +
+    (imagen ? `<img src="${esc(imagen)}" alt="${esc(nombre)}" width="600" />` : "") +
+    `<p>${esc(soles(precio))}</p>` +
+    (descripcion ? `<p>${esc(descripcion)}</p>` : "") +
+    (piezas.length ? `<h2>Incluye</h2><ul>${piezas.map((p) => `<li>${esc(p)}</li>`).join("")}</ul>` : "") +
+    `</main>`
+  );
+}
+
+/** Páginas de listado (categoría, catálogo, inicio): título, texto y enlaces rastreables a cada producto. */
+export function noscriptListado({ titulo, descripcion, productos, categorias = [] }) {
+  return (
+    `<main><nav>${enlaces(NAV)}</nav><h1>${esc(titulo)}</h1>` +
+    (descripcion ? `<p>${esc(descripcion)}</p>` : "") +
+    (categorias.length ? `<h2>Categorías</h2>${enlaces(categorias.map((c) => ({ href: `/categoria/${c.slug}`, texto: c.nombre })))}` : "") +
+    (productos.length ? `<h2>Productos</h2>${enlaces(productos.map((p) => ({ href: `/product/${p.id}`, texto: p.nombre })))}` : "") +
+    `</main>`
+  );
+}
+
+/* ───────── datos ───────── */
+
+export function ofertaInfo(p, ahora = Date.now()) {
+  const vence = p.oferta_vence_el ? new Date(p.oferta_vence_el).getTime() : null;
+  const activa = !!p.descuento_porcentaje && p.descuento_porcentaje > 0 && (!vence || vence > ahora);
+  const precioFinal = activa ? Math.round((p.precio - (p.precio * p.descuento_porcentaje) / 100) * 100) / 100 : p.precio;
+  return { activa, precioFinal };
+}
+
+export function imagenesDe(row, cloud) {
+  const nube = (id) => `https://res.cloudinary.com/${cloud}/image/upload/w_900,q_80,f_auto,h_900/${id}`;
+  const g = row.imagenes;
+  if (Array.isArray(g) && g.length > 0) {
+    return g.map((i) => (i?.public_id && cloud ? nube(i.public_id) : i?.url)).filter(Boolean);
+  }
+  if (row.imagen_public_id && cloud) return [nube(row.imagen_public_id)];
+  if (row.imagen_url) return [row.imagen_url];
+  return [];
+}
+
+/** Extrae las categorías de primer nivel de src/lib/categories.ts (slug, nombre, heroDescripcion). */
+export function leerCategorias(fuente) {
+  const re = /^ {4}slug:\s*"([a-z0-9-]+)",\s*\n\s*nombre:\s*"([^"]+)",[\s\S]*?heroDescripcion:\s*"([^"]+)"/gm;
+  return [...fuente.matchAll(re)].map((m) => ({ slug: m[1], nombre: m[2], descripcion: m[3] }));
+}
+
+export function paginaProducto(p, { sitio, cloud, categorias }) {
+  const cat = categorias.find((c) => c.slug === p.categoria);
+  const { activa, precioFinal } = ofertaInfo(p);
+  const imgs = imagenesDe(p, cloud);
+  const canonical = `${sitio}/product/${p.id}`;
+  const title = `${[p.nombre, cat?.nombre || p.categoria, p.material_base].filter(Boolean).join(" · ")} | G&M Mueblería`;
+  const description =
+    p.descripcion ||
+    `${p.nombre}${p.categoria ? ` — ${p.categoria}` : ""} fabricado a pedido en Lima por G&M Mueblería. Entrega a domicilio y 2 años de garantía en estructura.`;
+  return {
+    ruta: `/product/${p.id}`,
+    page: {
+      title,
+      description,
+      canonical,
+      image: imgs[0],
+      type: "product",
+      jsonLd: [
+        {
+          "@context": "https://schema.org",
+          "@type": "Product",
+          name: p.nombre,
+          description: p.descripcion || undefined,
+          sku: p.sku || p.id,
+          category: p.categoria || undefined,
+          material: p.material_base || undefined,
+          image: imgs,
+          brand: { "@type": "Brand", name: "G&M Mueblería" },
+          offers: {
+            "@type": "Offer",
+            url: canonical,
+            priceCurrency: "PEN",
+            price: Number(precioFinal).toFixed(2),
+            availability: (p.stock ?? 1) <= 0 ? "https://schema.org/OutOfStock" : "https://schema.org/InStock",
+            itemCondition: "https://schema.org/NewCondition",
+            seller: { "@type": "Organization", name: "G&M Mueblería" },
+          },
+        },
+      ],
+      noscript: noscriptProducto({
+        nombre: p.nombre, descripcion: p.descripcion, precio: precioFinal, precioOriginal: activa ? p.precio : null,
+        categoria: cat, imagenes: imgs, sitio,
+      }),
+    },
+  };
+}
+
+export function paginaCombo(c, { sitio, cloud }) {
+  const piezas = (c.combo_items ?? []).map((it) => it.products?.nombre).filter(Boolean);
+  const imgs = c.imagen_public_id && cloud ? imagenesDe(c, cloud) : c.imagen_url ? [c.imagen_url] : imagenesDe(c.combo_items?.[0]?.products ?? {}, cloud);
+  const canonical = `${sitio}/combo/${c.id}`;
+  return {
+    ruta: `/combo/${c.id}`,
+    page: {
+      title: `${c.nombre} — Combo de muebles | G&M Mueblería`,
+      description:
+        c.descripcion || `Combo ${c.nombre}: ${piezas.join(", ")}. Ahorra comprando el conjunto. Fabricado en Lima por G&M Mueblería.`,
+      canonical,
+      image: imgs[0],
+      type: "product",
+      jsonLd: [
+        {
+          "@context": "https://schema.org",
+          "@type": "Product",
+          name: c.nombre,
+          description: c.descripcion || undefined,
+          image: imgs,
+          brand: { "@type": "Brand", name: "G&M Mueblería" },
+          offers: {
+            "@type": "Offer", url: canonical, priceCurrency: "PEN", price: Number(c.precio_combo).toFixed(2),
+            availability: "https://schema.org/InStock", seller: { "@type": "Organization", name: "G&M Mueblería" },
+          },
+        },
+      ],
+      noscript: noscriptCombo({ nombre: c.nombre, descripcion: c.descripcion, precio: c.precio_combo, piezas, imagen: imgs[0] }),
+    },
+  };
+}
diff --git a/scripts/prerender.mjs b/scripts/prerender.mjs
new file mode 100644
index 0000000..d332204
--- /dev/null
+++ b/scripts/prerender.mjs
@@ -0,0 +1,173 @@
+// scripts/prerender.mjs
+// Se ejecuta DESPUÉS de `vite build` (ver "build" en package.json). Para cada página pública escribe
+// un HTML propio con título, descripción, canonical, Open Graph, JSON-LD y un resumen en <noscript>:
+//   dist/product/<id>/index.html · dist/combo/<id>/index.html · dist/categoria/<slug>/index.html
+//   dist/catalogo/index.html (y demás páginas fijas) · dist/index.html (inicio, con enlaces rastreables)
+// Render sirve un archivo existente ANTES de aplicar el rewrite a /index.html, y entrega
+// product/<id>/index.html tanto en /product/<id> como en /product/<id>/. La SPA funciona igual.
+//
+// Variables (las mismas del sitemap): SITE_URL o VITE_APP_URL_PROD, VITE_SUPABASE_URL,
+// VITE_SUPABASE_PUBLISHABLE_KEY, VITE_CLOUDINARY_CLOUD_NAME.
+// Nunca rompe el build: si algo falla, avisa y deja dist/ como estaba (la SPA sigue funcionando).
+// Para desactivarlo: PRERENDER=0.
+import { readFileSync, writeFileSync, existsSync, mkdirSync } from "node:fs";
+import { resolve, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { inyectar, leerCategorias, paginaProducto, paginaCombo, noscriptListado } from "./prerender-lib.mjs";
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+const dist = resolve(root, "dist");
+
+// .env local (en Render las variables ya vienen en process.env)
+const envPath = resolve(root, ".env");
+if (existsSync(envPath)) {
+  for (const line of readFileSync(envPath, "utf8").split(/\r?\n/)) {
+    const m = line.match(/^\s*([A-Z0-9_]+)\s*=\s*(.*)\s*$/i);
+    if (m && process.env[m[1]] === undefined) process.env[m[1]] = m[2].replace(/^["']|["']$/g, "");
+  }
+}
+
+const SITE = (process.env.SITE_URL || process.env.VITE_APP_URL_PROD || "").trim().replace(/\/+$/, "");
+const SB_URL = (process.env.VITE_SUPABASE_URL || process.env.SUPABASE_URL || "").trim().replace(/\/+$/, "");
+const SB_KEY = (process.env.VITE_SUPABASE_PUBLISHABLE_KEY || process.env.SUPABASE_PUBLISHABLE_KEY || "").trim();
+const CLOUD = (process.env.VITE_CLOUDINARY_CLOUD_NAME || "").trim();
+
+if (process.env.PRERENDER === "0") {
+  console.log("[prerender] Desactivado (PRERENDER=0).");
+  process.exit(0);
+}
+if (!/^https:\/\//.test(SITE)) {
+  console.warn("[prerender] Define SITE_URL (https://...) en el build. Se omite el prerenderizado.");
+  process.exit(0);
+}
+const plantillaPath = resolve(dist, "index.html");
+if (!existsSync(plantillaPath)) {
+  console.warn("[prerender] No existe dist/index.html (¿falló vite build?). Se omite.");
+  process.exit(0);
+}
+const plantilla = readFileSync(plantillaPath, "utf8");
+
+async function sbTodo(query) {
+  const filas = [];
+  for (let offset = 0; offset < 10000; offset += 1000) {
+    const sep = query.includes("?") ? "&" : "?";
+    const res = await fetch(`${SB_URL}/rest/v1/${query}${sep}limit=1000&offset=${offset}`, {
+      headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}` },
+    });
+    if (!res.ok) throw new Error(`${res.status} ${await res.text()}`);
+    const lote = await res.json();
+    filas.push(...lote);
+    if (lote.length < 1000) break;
+  }
+  return filas;
+}
+
+function escribir(ruta, html) {
+  const destino = ruta === "/" ? plantillaPath : resolve(dist, `.${ruta}`, "index.html");
+  mkdirSync(dirname(destino), { recursive: true });
+  writeFileSync(destino, html);
+}
+
+try {
+  let categorias = [];
+  try {
+    categorias = leerCategorias(readFileSync(resolve(root, "src/lib/categories.ts"), "utf8"));
+  } catch (e) {
+    console.warn("[prerender] No pude leer las categorías:", e.message);
+  }
+
+  let productos = [];
+  let combos = [];
+  if (SB_URL && SB_KEY) {
+    try {
+      productos = await sbTodo("products?select=*&activo=eq.true&order=created_at.desc");
+    } catch (e) {
+      console.warn("[prerender] No pude leer productos:", e.message);
+    }
+    try {
+      const ahora = new Date().toISOString();
+      combos = await sbTodo(
+        `combos?select=*,combo_items(cantidad,products(nombre,imagenes,imagen_public_id,imagen_url))&activo=eq.true&or=(vence_el.is.null,vence_el.gt.${ahora})`,
+      );
+    } catch (e) {
+      console.warn("[prerender] No pude leer combos:", e.message);
+    }
+  } else {
+    console.warn("[prerender] Sin credenciales de Supabase: solo páginas fijas y categorías.");
+  }
+
+  const ctx = { sitio: SITE, cloud: CLOUD, categorias };
+  let n = 0;
+
+  for (const p of productos) {
+    const { ruta, page } = paginaProducto(p, ctx);
+    escribir(ruta, inyectar(plantilla, page));
+    n++;
+  }
+  for (const c of combos) {
+    const { ruta, page } = paginaCombo(c, ctx);
+    escribir(ruta, inyectar(plantilla, page));
+    n++;
+  }
+
+  const listaProductos = productos.map((p) => ({ id: p.id, nombre: p.nombre }));
+  for (const c of categorias) {
+    const propios = productos.filter((p) => p.categoria === c.slug).map((p) => ({ id: p.id, nombre: p.nombre }));
+    escribir(
+      `/categoria/${c.slug}`,
+      inyectar(plantilla, {
+        title: `${c.nombre} — G&M Mueblería`,
+        description: c.descripcion,
+        canonical: `${SITE}/categoria/${c.slug}`,
+        noscript: noscriptListado({ titulo: c.nombre, descripcion: c.descripcion, productos: propios }),
+      }),
+    );
+    n++;
+  }
+
+  // Páginas fijas (mismos títulos y descripciones que el head() de cada ruta)
+  const fijas = [
+    ["/catalogo", "Catálogo completo — G&M Mueblería", "Explora todos nuestros muebles: salas, comedores, recámaras, separadores de ambiente y accesorios.", true],
+    ["/nosotros", "Nuestro taller — G&M Mueblería", "Conoce cómo fabricamos cada mueble en nuestro taller de Lima: madera tornillo seca y tratada, acabado a mano y control de calidad pieza por pieza."],
+    ["/proyectos", "Proyectos — G&M Mueblería", "Piezas especiales e ideas nuevas que fabricamos en nuestro taller de Lima."],
+    ["/testimonios", "Testimonios — G&M Mueblería", "Fotos reales y reseñas verificadas de clientes con sus muebles G&M."],
+    ["/envios", "Envíos y entregas — G&M Mueblería", "Plazos de entrega en Lima y provincias, recojo en tienda y cómo coordinamos la entrega de tu mueble."],
+    ["/terminos", "Términos y condiciones — G&M Mueblería", "Condiciones de compra, fabricación a pedido, pagos, garantía y cambios de G&M Mueblería."],
+    ["/privacidad", "Política de privacidad — G&M Mueblería", "Qué datos recopilamos, para qué los usamos y cómo ejercer tus derechos sobre ellos."],
+  ];
+  for (const [ruta, title, description, conProductos] of fijas) {
+    escribir(
+      ruta,
+      inyectar(plantilla, {
+        title,
+        description,
+        canonical: `${SITE}${ruta}`,
+        noscript: noscriptListado({
+          titulo: title.replace(/ — G&M Mueblería$/, ""),
+          descripcion: description,
+          productos: conProductos ? listaProductos : [],
+          categorias: conProductos ? categorias : [],
+        }),
+      }),
+    );
+    n++;
+  }
+
+  // Inicio: se conservan sus metas y se añaden enlaces rastreables a categorías y productos
+  escribir(
+    "/",
+    inyectar(plantilla, {
+      noscript: noscriptListado({
+        titulo: "G&M Mueblería — Muebles artesanales de madera natural",
+        descripcion: "Muebles de madera natural hechos a mano en Lima, con entrega a domicilio.",
+        productos: listaProductos.slice(0, 60),
+        categorias,
+      }),
+    }),
+  );
+  n++;
+
+  console.log(`[prerender] ${n} páginas (${productos.length} productos, ${combos.length} combos, ${categorias.length} categorías).`);
+} catch (e) {
+  console.warn("[prerender] Falló, se deja dist/ como estaba:", e?.message ?? e);
+}
diff --git a/scripts/prerender.test.mjs b/scripts/prerender.test.mjs
new file mode 100644
index 0000000..d3b8c0f
--- /dev/null
+++ b/scripts/prerender.test.mjs
@@ -0,0 +1,118 @@
+// Ejecutar: node --test scripts/prerender.test.mjs
+import test from "node:test";
+import assert from "node:assert/strict";
+import { inyectar, esc, ofertaInfo, imagenesDe, paginaProducto, paginaCombo, noscriptListado } from "./prerender-lib.mjs";
+
+const PLANTILLA = `<!DOCTYPE html>
+<html lang="es-PE">
+  <head>
+    <meta charset="UTF-8" />
+    <title>G&M Mueblería — Muebles artesanales de madera natural</title>
+    <meta name="description" content="Descripción genérica" />
+    <meta property="og:title" content="Título genérico" />
+    <meta property="og:type" content="website" />
+    <meta property="og:image" content="https://t.pe/og-default.jpg" />
+    <meta property="og:image:width" content="1200" />
+    <meta property="og:image:height" content="630" />
+    <meta property="og:image:alt" content="genérica" />
+    <meta name="twitter:card" content="summary_large_image" />
+    <meta name="twitter:image" content="https://t.pe/og-default.jpg" />
+    <script type="application/ld+json">{"@type":"FurnitureStore"}</script>
+  </head>
+  <body>
+    <div id="root"></div>
+    <script type="module" src="/assets/app.js"></script>
+  </body>
+</html>`;
+
+const cats = [{ slug: "muebles", nombre: "Muebles", descripcion: "x" }];
+const ctx = { sitio: "https://t.pe", cloud: "demo", categorias: cats };
+const producto = {
+  id: "11111111-1111-1111-1111-111111111111", nombre: 'Sofá "Londres" <3 plazas>', descripcion: "Sofá de madera & tela",
+  precio: 1000, descuento_porcentaje: 10, oferta_vence_el: null, categoria: "muebles", material_base: "Madera",
+  stock: 4, sku: "SOF-1", imagenes: [{ public_id: "a/b", url: "x" }],
+};
+
+test("esc no duplica entidades ya escapadas y escapa lo peligroso", () => {
+  assert.equal(esc("G&M"), "G&amp;M");
+  assert.equal(esc("G&amp;M"), "G&amp;M");
+  assert.equal(esc('<a href="x">'), "&lt;a href=&quot;x&quot;&gt;");
+});
+
+test("inyectar cambia título y metas en sitio y guarda el original para head.ts", () => {
+  const html = inyectar(PLANTILLA, paginaProducto(producto, ctx).page);
+  assert.match(html, /<title>Sofá &quot;Londres&quot; &lt;3 plazas&gt; · Muebles · Madera \| G&amp;M Mueblería<\/title>/);
+  assert.match(html, /data-gm-base-title="G&amp;M Mueblería — Muebles artesanales de madera natural"/);
+  // la meta description existente se edita en sitio (no se duplica) y recuerda el valor genérico
+  assert.equal((html.match(/name="description"/g) ?? []).length, 1);
+  assert.match(html, /<meta data-gm-orig="Descripción genérica" name="description" content="Sofá de madera &amp; tela" \/>/);
+  assert.equal((html.match(/property="og:title"/g) ?? []).length, 1);
+  assert.match(html, /data-gm-orig="Título genérico"/);
+});
+
+test("quita las medidas de og:image genéricas y pone la imagen del producto", () => {
+  const html = inyectar(PLANTILLA, paginaProducto(producto, ctx).page);
+  assert.doesNotMatch(html, /og:image:width|og:image:height|og:image:alt/);
+  assert.match(html, /property="og:image"[^>]*content="https:\/\/res\.cloudinary\.com\/demo\/image\/upload\/w_900,q_80,f_auto,h_900\/a\/b"/);
+});
+
+test("las etiquetas nuevas (canonical, og:url, JSON-LD) llevan data-gm-head y no se duplican", () => {
+  const html = inyectar(PLANTILLA, paginaProducto(producto, ctx).page);
+  assert.equal((html.match(/rel="canonical"/g) ?? []).length, 1);
+  assert.match(html, /<link rel="canonical" href="https:\/\/t\.pe\/product\/1111[^"]*" data-gm-head="1" \/>/);
+  assert.match(html, /<meta property="og:url" content="https:\/\/t\.pe\/product\/[^"]*" data-gm-head="1" \/>/);
+  const lds = html.match(/<script type="application\/ld\+json"[^>]*>/g) ?? [];
+  assert.equal(lds.length, 2); // el FurnitureStore global + el Product
+  assert.equal(lds.filter((l) => l.includes("data-gm-head")).length, 1);
+});
+
+test("JSON-LD: precio con descuento, disponibilidad y sin romper el <script>", () => {
+  const p = { ...producto, nombre: "Mesa </script><b>", stock: 0 };
+  const html = inyectar(PLANTILLA, paginaProducto(p, ctx).page);
+  const ld = html.match(/<script type="application\/ld\+json" data-gm-head="1">([\s\S]*?)<\/script>/)[1];
+  assert.doesNotMatch(ld, /<\/script>/);
+  const obj = JSON.parse(ld);
+  assert.equal(obj.offers.price, "900.00");
+  assert.equal(obj.offers.availability, "https://schema.org/OutOfStock");
+  assert.equal(obj.sku, "SOF-1");
+});
+
+test("ofertaInfo ignora descuentos vencidos", () => {
+  assert.equal(ofertaInfo({ precio: 100, descuento_porcentaje: 20, oferta_vence_el: "2020-01-01" }).precioFinal, 100);
+  assert.equal(ofertaInfo({ precio: 100, descuento_porcentaje: 20, oferta_vence_el: null }).precioFinal, 80);
+});
+
+test("imagenesDe respeta el orden: galería → public_id → url", () => {
+  assert.deepEqual(imagenesDe({ imagenes: [{ url: "u1" }, { url: "u2" }] }, "c"), ["u1", "u2"]);
+  assert.match(imagenesDe({ imagen_public_id: "p" }, "c")[0], /res\.cloudinary\.com\/c\/.*\/p$/);
+  assert.deepEqual(imagenesDe({ imagen_url: "https://x/y.jpg" }, ""), ["https://x/y.jpg"]);
+  assert.deepEqual(imagenesDe({}, "c"), []);
+});
+
+test("<noscript> con contenido escapado antes del #root, y enlaces a productos en el listado", () => {
+  const html = inyectar(PLANTILLA, paginaProducto(producto, ctx).page);
+  assert.match(html, /<noscript><main>[\s\S]*<h1>Sofá &quot;Londres&quot; &lt;3 plazas&gt;<\/h1>[\s\S]*S\/ 900\.00[\s\S]*<\/noscript>\s*<div id="root"><\/div>/);
+  const lista = noscriptListado({ titulo: "Catálogo", productos: [{ id: "a1", nombre: "Mesa" }], categorias: cats });
+  assert.match(lista, /<a href="\/product\/a1">Mesa<\/a>/);
+  assert.match(lista, /<a href="\/categoria\/muebles">Muebles<\/a>/);
+});
+
+test("combo: usa precio_combo e incluye las piezas", () => {
+  const combo = {
+    id: "c1", nombre: "Sala completa", descripcion: null, precio_combo: 2500, imagen_url: "https://x/c.jpg",
+    combo_items: [{ products: { nombre: "Sofá" } }, { products: { nombre: "Mesa" } }],
+  };
+  const { ruta, page } = paginaCombo(combo, ctx);
+  assert.equal(ruta, "/combo/c1");
+  assert.match(page.description, /Sofá, Mesa/);
+  assert.equal(page.jsonLd[0].offers.price, "2500.00");
+  assert.match(inyectar(PLANTILLA, page), /<li>Sofá<\/li><li>Mesa<\/li>/);
+});
+
+test("el inicio conserva sus metas: solo añade <noscript>", () => {
+  const html = inyectar(PLANTILLA, { noscript: noscriptListado({ titulo: "Inicio", productos: [], categorias: cats }) });
+  assert.match(html, /<title>G&M Mueblería — Muebles artesanales de madera natural<\/title>/);
+  assert.match(html, /content="Descripción genérica"/);
+  assert.doesNotMatch(html, /data-gm-orig/);
+  assert.match(html, /<noscript>/);
+});
