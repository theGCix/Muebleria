--- /dev/null
+++ b/src/lib/avisoFavorito.ts
@@ -0,0 +1,21 @@
+// src/lib/avisoFavorito.ts
+// D11: aviso de favoritos en la parte inferior de la pantalla, con la opción «Deshacer».
+// El Toaster (src/routes/__root.tsx) deja libre la barra inferior móvil y la barra de compra de la ficha.
+import { toast } from "sonner";
+
+/**
+ * @param agregado  true si el producto quedó guardado; false si se quitó.
+ * @param deshacer  acción contraria (quitarlo si se guardó, guardarlo si se quitó).
+ */
+export function avisoFavorito(nombre: string, agregado: boolean, deshacer: () => Promise<unknown> | void) {
+  toast.success(agregado ? `"${nombre}" guardado en favoritos` : `"${nombre}" eliminado de favoritos`, {
+    position: "bottom-center",
+    duration: 6000,
+    action: {
+      label: "Deshacer",
+      onClick: () => {
+        void deshacer();
+      },
+    },
+  });
+}
diff --git a/src/lib/buscarDistrito.ts b/src/lib/buscarDistrito.ts
new file mode 100644
index 0000000..215dcfd
--- /dev/null
+++ b/src/lib/buscarDistrito.ts
@@ -0,0 +1,15 @@
+// src/lib/buscarDistrito.ts
+// Búsqueda del selector de distrito (DistritoCombobox): sin tildes ni mayúsculas.
+
+/** Minúsculas y sin tildes: «ancon» encuentra «Ancón». */
+export const normalizarBusqueda = (t: string) =>
+  t.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();
+
+/** Filtro de cmdk: 1 si el distrito empieza con lo escrito, 0.5 si lo contiene, 0 si no coincide. */
+export function filtrarDistrito(valor: string, busqueda: string): number {
+  const q = normalizarBusqueda(busqueda);
+  if (!q) return 1;
+  const v = normalizarBusqueda(valor);
+  if (v.startsWith(q)) return 1;
+  return v.includes(q) ? 0.5 : 0;
+}
