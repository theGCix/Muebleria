+    const sincronizar = () => {
+      setTotal(api.scrollSnapList().length);
+      setActual(api.selectedScrollSnap());
+      setPuedeAtras(api.canScrollPrev());
+      setPuedeAdelante(api.canScrollNext());
+    };
+    sincronizar();
