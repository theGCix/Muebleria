+          <div className="grid grid-cols-1 md:grid-cols-3 gap-2">
+            {alertas.map((a, i) => (
+              <AlertPill key={i} {...a} />
+            ))}
+          </div>
+        )}
       </div>
     </div>
   );
-}
\ No newline at end of file
+}
